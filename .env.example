# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agileboard?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo mode: shows "Try Demo" on the login page and enables the passwordless
# "demo" auth provider. Leave unset/false on any deployment holding real data.
NEXT_PUBLIC_DEMO_MODE="true"
DEMO_USER_EMAIL="demo@agileboard.dev"

# Optional: password for the seeded alice/bob/carol users.
# If empty, `npm run db:seed` generates a random one and prints it once.
SEED_PASSWORD=""
